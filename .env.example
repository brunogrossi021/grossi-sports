# Desenvolvimento
DB_DEV_URL=jdbc:postgresql://localhost:5432/suporteos2026_dev
DB_DEV_USERNAME=suporteos_app
DB_DEV_PASSWORD=substitua_pela_senha_local

# Testes
DB_TEST_URL=jdbc:postgresql://localhost:5432/suporteos2026_test
DB_TEST_USERNAME=suporteos_app
DB_TEST_PASSWORD=substitua_pela_senha_local

# Produção: definidos pela plataforma, não pelo repositório
DB_URL=jdbc:postgresql://servidor:5432/banco
DB_USERNAME=usuario_da_aplicacao
DB_PASSWORD=substitua_pelo_segredo_da_plataforma

# Aula 13 - assinatura HS256 dos JWT
# Gere uma chave própria e aleatória de 32 bytes (256 bits) em Base64.
# O valor abaixo é proposital e não funciona como chave: obriga a geração consciente.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# macOS/Linux: openssl rand -base64 32
JWT_SECRET=substitua-por-uma-chave-base64-de-256-bits

# Aula 16 - Ciclo de vida dos refresh tokens (durações ISO-8601)
# idle-timeout: sessão expira após este tempo sem renovação.
# absolute-expiration: limite absoluto da família (deve ser maior).
REFRESH_TOKEN_IDLE_TIMEOUT=PT30M
REFRESH_TOKEN_ABSOLUTE_EXPIRATION=PT8H

# Aula 14 - Administrador inicial (bootstrap da primeira conta)
# Deixe INITIAL_ADMIN_ENABLED=false no dia a dia. Ative apenas na
# primeira execução de um banco vazio e desative logo depois.
# Nunca versione a senha real: use um valor local no .env.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_NAME=Administrador Local
INITIAL_ADMIN_EMAIL=administrador@example.com
INITIAL_ADMIN_CPF=52998224725
INITIAL_ADMIN_LOGIN=administrador
INITIAL_ADMIN_PASSWORD=substitua-por-uma-senha-forte-e-local
